# Mayhem target: LnkParse Windows .lnk shortcut parser (Atheris/libFuzzer harness).
# The cmd binary is the compiled ELF launcher that drives mayhem/fuzz_lnkfile.py; Atheris
# instruments the `lnkfile` library so the run records coverage (edges).
# origin: https://app.mayhem.security/mayhemheroes/lnkparse/lnkfile-parse/3
project: savantenvs/LnkParse
target: lnkfile-parse-buggy-mhh-run-3

cmds:
  - cmd: /mayhem/lnkparse_fuzzer
    libfuzzer: true
    timeout: 30

# Seed corpus of representative .lnk shortcut blobs (file:// URIs per the Mayhemfile schema).
testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
